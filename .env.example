# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (enable Organizations in the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase Postgres (use the pooled "Transaction" connection string)
DATABASE_URL=

# 32 random bytes, base64. Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Stripe billing for the SaaS itself (your platform account, not customers' keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_EXECUTIVE=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vercel cron auth (Vercel sends: Authorization: Bearer $CRON_SECRET)
CRON_SECRET=
